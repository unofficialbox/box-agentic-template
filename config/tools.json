        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_version": {
            "type": "string",
            "minLength": 1
          },
          "changes": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "rate": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "term_months": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "record_id",
          "expected_version",
          "changes"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_version": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "type": "object"
          },
          "changes": {
            "type": "object"
          },
          "requires_human_approval": {
            "const": true
          },
          "applied": {
            "const": false
          }
        },
        "required": [
          "record_id",
          "expected_version",
          "before",
          "changes",
          "requires_human_approval",
          "applied"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "implementation": "mock",
      "live_binding": null
    },
