{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "business_prompt": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "system_of_record": {
      "const": "Salesforce"
    },
    "content_authority": {
      "const": "Box"
    },
    "decision_owner": {
      "type": "string",
      "minLength": 1
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "not_implemented": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "failure": {
            "type": "string",
            "minLength": 1
          },
          "tool": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "actor",
          "action",
          "tool",
          "prompt",
          "expected",
          "failure"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 12
    }
  },
  "additionalProperties": false,
  "required": [
    "title",
    "business_prompt",
    "outcome",
    "system_of_record",
    "content_authority",
    "decision_owner",
    "record_id",
    "actors",
    "assumptions",
    "acceptance",
    "not_implemented",
    "steps"
  ]
}
