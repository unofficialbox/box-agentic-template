        "naming": {
          "pattern": "{name} - {suffix}"
        },
        "rollback": {
          "enabled": true,
          "directory": ".dispatch/deployments",
          "retain": 10
        },
        "component_strategies": {},
        "components": {
          "mode": "defaults",
          "selections": {}
        }
      }
    }
  },
  "resources": []
}
